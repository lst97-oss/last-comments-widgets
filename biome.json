{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.angular",
      "!**/*.json",
      "!packages/angular",
      "!packages/vue",
      "!**/.changeset"
    ]
  },
  "formatter": { "enabled": false },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "includes": ["packages/*/src/**", "packages/theme/**", "scripts/**", "eslint.config.js"],
    "rules": { "preset": "recommended" }
  },
  "assist": {
    "enabled": true,
    "includes": ["packages/*/src/**", "scripts/**", "eslint.config.js"],
    "actions": { "source": { "organizeImports": { "level": "on", "options": { "sortBareImports": false } } } }
  },
  "overrides": [{ "includes": ["packages/react/**"], "linter": { "domains": { "react": "recommended" } } }]
}

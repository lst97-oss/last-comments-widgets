{
  "name": "last-comments-widgets",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "check": "bun run format:check && bun scripts/check-all.ts",
    "lint": "bun scripts/lint-all.ts",
    "test": "bun test",
    "build": "bun scripts/build-all.ts",
    "lint:fix": "bun scripts/lint-all.ts --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "fmt:staged": "bun fmt --staged",
    "typecheck": "bun --filter '@last-comments-widgets/*' typecheck",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "versions:check": "bun scripts/check-versions.ts",
    "pack:check": "bun scripts/check-pack.ts",
    "update:deps": "bun scripts/update-deps.ts",
    "version": "changeset version && bun install && bun run versions:check",
    "release": "bun run versions:check && bun run check && bun test && bun run build && bun run pack:check && changeset publish",
    "test:theme": "bun run build && bun scripts/check-theme.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.6.0",
    "bun-types": "^1.4.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "playwright-core": "1.64.1",
    "react-doctor": "^0.9.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vue-eslint-parser": "^10.4.1"
  }
}

{
  "name": "last-comments-widgets",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "check": "bun scripts/check-all.ts",
    "lint": "bun scripts/lint-all.ts",
    "test": "bun test",
    "build": "bun scripts/build-all.ts",
    "lint:fix": "bun scripts/lint-all.ts --fix",
    "format": "biome format --write . && prettier --write \"packages/{angular,vue}/**/*.{ts,vue,html,css,json}\"",
    "format:check": "biome format . && prettier --check \"packages/{angular,vue}/**/*.{ts,vue,html,css,json}\"",
    "typecheck": "bun --filter '@last-comments/*' typecheck",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "versions:check": "bun scripts/check-versions.ts",
    "pack:check": "bun scripts/check-pack.ts",
    "version": "changeset version && bun install && bun run versions:check",
    "release": "bun run versions:check && bun run check && bun test && bun run build && bun run pack:check && changeset publish",
    "test:theme": "bun run build && bun scripts/check-theme.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10",
    "angular-eslint": "^22",
    "bun-types": "^1.4.3",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10",
    "globals": "^17.13.0",
    "playwright-core": "1.64.1",
    "prettier": "^3",
    "react-doctor": "^0.9.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8",
    "vue-eslint-parser": "^10"
  }
}

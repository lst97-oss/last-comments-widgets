{
  "name": "@last-comments-widgets/angular",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standard last-comments widget for Angular.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lst97-oss/last-comments-widgets.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/lst97-oss/last-comments-widgets#readme",
  "bugs": {
    "url": "https://github.com/lst97-oss/last-comments-widgets/issues"
  },
  "keywords": [
    "comments",
    "comment-system",
    "angular",
    "tailwindcss",
    "last-comments"
  ],
  "exports": {
    ".": {
      "import": "./dist/fesm2022/last-comments-widgets-angular.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/types/last-comments-widgets-angular.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "lint": "eslint . --max-warnings 0",
    "build": "bunx ng-packagr -p ng-package.json && bunx @tailwindcss/cli -i ./src/styles.css -o ./dist/styles.css && bun ../../scripts/isolate-styles.ts ./dist/styles.css && bun ../../scripts/copy-fonts.ts .",
    "test": "bun test",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "bun check --no-script"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@last-comments-widgets/client": "workspace:*",
    "@lucide/angular": "1.59.0"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0"
  },
  "devDependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@last-comments-widgets/theme": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "ng-packagr": "22.2.4",
    "rxjs": "^7.8.2",
    "tailwindcss": "4.3.3",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3"
  }
}

{
  "name": "@lst97-oss/last-comments-widgets",
  "version": "0.4.2",
  "type": "module",
  "description": "Drop-in comment widgets for last-comments — React, Vue, Angular and plain HTML on one API client and one Tailwind v4 + shadcn base-nova theme.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lst97-oss/last-comments-widgets.git",
    "directory": "packages/last-comments-widgets"
  },
  "homepage": "https://github.com/lst97-oss/last-comments-widgets#readme",
  "bugs": {
    "url": "https://github.com/lst97-oss/last-comments-widgets/issues"
  },
  "keywords": [
    "comments",
    "comment-system",
    "react",
    "vue",
    "angular",
    "vanilla-js",
    "tailwindcss",
    "shadcn",
    "last-comments"
  ],
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./angular": {
      "types": "./dist/angular/types/last-comments-widgets-angular.d.ts",
      "import": "./dist/angular/fesm2022/last-comments-widgets-angular.mjs",
      "default": "./dist/angular/fesm2022/last-comments-widgets-angular.mjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./react/styles.css": "./dist/react/styles.css",
    "./vue/styles.css": "./dist/vue/styles.css",
    "./angular/styles.css": "./dist/angular/styles.css",
    "./vanilla/styles.css": "./dist/vanilla/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/assemble-package.ts"
  },
  "dependencies": {
    "marked": "^18.1.1"
  },
  "peerDependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@base-ui/react": "^1.9.0",
    "@lucide/angular": "1.59.0",
    "@lucide/vue": "^1.60.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reka-ui": "^2.11.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "vue": "~3.5.44"
  },

{
  "name": "@last-comments-widgets/vanilla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standard last-comments widget for plain HTML (no framework).",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/lst97-oss/last-comments-widgets.git", "directory": "packages/vanilla" },
  "homepage": "https://github.com/lst97-oss/last-comments-widgets#readme",
  "bugs": { "url": "https://github.com/lst97-oss/last-comments-widgets/issues" },
  "keywords": ["comments", "comment-system", "vanilla-js", "tailwindcss", "last-comments"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "lint": "biome check --error-on-warnings .",
    "build": "bunx tsup src/index.ts --format esm --clean --dts --target es2025 --out-dir dist && bunx @tailwindcss/cli -i ./src/styles.css -o ./dist/styles.css && bun ../../scripts/isolate-styles.ts ./dist/styles.css && bun ../../scripts/copy-fonts.ts .",
    "test": "bun test",
    "lint:fix": "biome check --error-on-warnings --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "bun --check"
  },
  "dependencies": {
    "@last-comments-widgets/client": "workspace:*"
  },
  "devDependencies": {
    "@last-comments-widgets/theme": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}

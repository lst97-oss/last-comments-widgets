  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --error-on-warnings --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run lint && bun run format:check"
  }

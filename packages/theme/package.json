{
  "name": "@last-comments/theme",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared Tailwind v4 + shadcn base-nova theme tokens for last-comments widgets.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/lst97-oss/last-comments-widgets.git", "directory": "packages/theme" },
  "homepage": "https://github.com/lst97-oss/last-comments-widgets#readme",
  "bugs": { "url": "https://github.com/lst97-oss/last-comments-widgets/issues" },
  "keywords": ["comments", "tailwindcss", "shadcn", "theme", "last-comments"],
  "exports": {
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "theme.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
